{
  "manifest_version": 3,
  "name": "Sonavia — Floating Player, Lyrics & DJ",
  "version": "2.0.0",
  "description": "Floating Spotify player with synced lyrics and a DJ mixer: speed, pitch, EQ, reverb. In every tab, a popup, or over any app.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://lrclib.net/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "content/audio-engine.js",
        "content/main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "content/spotify-dom.js",
        "content/spotify-search.js",
        "content/overlay-view.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "content/overlay-view.js",
        "content/mirror.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Toggle Sonavia",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
